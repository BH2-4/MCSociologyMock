DATABASE_URL=postgresql://agorasim:agorasim@localhost:5432/agorasim
SERVER_PORT=4100
NEXT_PUBLIC_API_URL=http://localhost:4100

# OpenAI-compatible LLM adapter. MiniMax Token Plan example values are shown;
# the subscription key is distinct from a pay-as-you-go API key.
PROGRAM_E_AI_BASE_URL=https://api.minimaxi.com/v1
PROGRAM_E_AI_API_KEY=
PROGRAM_E_AI_MODEL=MiniMax-M2.7

# Injective x402 testnet. Never commit real keys.
X402_MODE=mock
X402_FACILITATOR_URL=http://localhost:4020
PUBLIC_RESOURCE_BASE_URL=http://localhost:4100
MERCHANT_AGENT_ADDRESS=
FACILITATOR_PRIVATE_KEY=
FACILITATOR_SERVICE_TOKEN=
FACILITATOR_ALLOWED_IPS=127.0.0.1,::1
FACILITATOR_PORT=4020
INJECTIVE_EVM_RPC_URL=https://k8s.testnet.json-rpc.injective.network

# Four branch-isolated seed wallets. Values point to local secret env vars.
CONTROL_SEED_01_KEY_REF=env:CONTROL_SEED_01_PRIVATE_KEY
CONTROL_SEED_02_KEY_REF=env:CONTROL_SEED_02_PRIVATE_KEY
TREATMENT_SEED_01_KEY_REF=env:TREATMENT_SEED_01_PRIVATE_KEY
TREATMENT_SEED_02_KEY_REF=env:TREATMENT_SEED_02_PRIVATE_KEY
CONTROL_SEED_01_PRIVATE_KEY=
CONTROL_SEED_02_PRIVATE_KEY=
TREATMENT_SEED_01_PRIVATE_KEY=
TREATMENT_SEED_02_PRIVATE_KEY=
TESTNET_RECEIPT_FIXTURE_PATH=fixtures/testnet-seed-receipts.json
